# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           qt4 1.0
PortGroup           legacysupport 1.1

# Kate 4.14 (the last Qt 4 based Kate) built against plain Qt 4, without
# kdelibs, kdeinit, D-Bus or X11. Branch qt4-pure of the kate fork carries
# the qt4compat layer; see BUILDING-QT4.md in the tree.
name                kate-qt4
version             4.14.3.qt4.0
revision            0

# Source tarball: the qt4-pure tree (kate KDE/4.14 head f17e4c99 plus the
# qt4compat layer). Host it and point master_sites at it, or drop it into
# ${prefix}/var/macports/distfiles/kate-qt4/ for a local build.
master_sites        https://github.com/macos-powerpc/kate/releases/download/v${version}/
distname            kate-qt4-${version}
use_xz              yes
checksums           rmd160  2ee9c5a7dbdb96c13998773a789e64525ad74d76 \
                    sha256  49af930994df9c1b2c784b1a084541e00e9a59463c28d7693d134e3fd8463365 \
                    size    4024464

# Alternative once the branch is pushed: fetch from git instead of the tarball
#fetch.type          git
#git.url             https://github.com/macos-powerpc/kate
#git.branch          qt4-pure
categories          editors aqua
license             {LGPL-2+ GPL-2+}
maintainers         nomaintainer
description         KWrite/Kate text editor built on plain Qt 4, without KDE libraries
long_description    KatePart is the advanced editor component of the KDE Kate project; \
                    KWrite is its single-document editor shell. This port builds the \
                    Kate 4.14 code base against Qt 4 only: the kdelibs pieces it needs \
                    are replaced by a small in-tree compatibility layer, so there is no \
                    kdelibs, kdeinit, ksycoca, D-Bus or X11 dependency.
homepage            https://kate-editor.org

depends_build-append \
                    port:perl5
depends_lib-append  port:zlib \
                    port:bzip2

# Kate 4.14 is C++98 code; gnu++11 keeps the 'register' declarations legal
# without asking anything of the compiler beyond C++11.
compiler.cxx_standard   2011

configure.args-append \
                    -DPERL_EXECUTABLE=${prefix}/bin/perl5 \
                    -DKATE_BUILD_KWRITE=ON \
                    -DKATE_BUILD_KATE=OFF \
                    -DKATE_BUILD_ADDONS=OFF \
                    -DBUILD_TESTING=OFF \
                    -DKATE_INSTALL_BUNDLE_DIR=${applications_dir}

# qt4-mac may be installed in concurrent mode under ${prefix}/libexec/qt4
configure.args-append \
                    -DQT_QMAKE_EXECUTABLE=${qt_qmake_cmd}

variant kate description {Also build the Kate MDI application (phase 2, not yet functional)} {
    configure.args-replace  -DKATE_BUILD_KATE=OFF -DKATE_BUILD_KATE=ON
}

livecheck.type      none
