/*
 * The plugins linked into this executable. GENERATED by CMake from
 * cmake/katebuiltinplugins.cpp.in (kate_builtin_plugins_source): one line
 * per plugin registered with kate_add_static_plugin() (Kate application
 * plugins, global property KATE_STATIC_PLUGINS) or
 * kate_add_static_editor_plugin() (KatePart editor plugins,
 * KTEXTEDITOR_STATIC_PLUGINS).
 *
 * There is no dynamic plugin loading in the pure Qt 4 build: every plugin is
 * a static library and is made known to KPluginLoader here, Q_IMPORT_PLUGIN
 * style. The name is the plugin's X-KDE-Library value; KatePluginManager and
 * KatePartPluginManager still discover plugins through
 * KServiceTypeTrader::query("Kate/Plugin" / "KTextEditor/Plugin"), i.e.
 * through the .desktop files installed under services/, and create them
 * through KService::createInstance().
 *
 * This file must be compiled into the executable itself (not a library):
 * the registrars are static objects that nothing references, which the
 * linker keeps only for object files it links unconditionally.
 */

#include <kpluginloader.h>

@KATE_PLUGIN_IMPORTS@

